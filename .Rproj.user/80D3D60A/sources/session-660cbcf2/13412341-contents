## Loading Packages
library(tidyverse)
library(dplyr)
library(ggplot2)
library(readxl)
library(writexl)
library(cowplot)



# REMEMBER: before loading data set working directory to source folder 

# ===================================================================
# Loading and Cleaning up Taxa and Transect Data
# ===================================================================

# Loading target taxa data
summer<-read_xlsx("./data/thesis_cleaned.xlsx", sheet= "summer")
fall_winter<-read_xlsx("./data/thesis_cleaned.xlsx", sheet= "fall_winter")

taxa<- rbind(summer, fall_winter) # combining sample periods into one dataframe
 
taxa<-taxa %>% 
 select(-collected, -sample_number) #removing extraneous columns: collected, sample_number

# Loading transect data
summer_transects<-read_xlsx("./data/transects.xlsx", sheet= "transect_summer")
fall_winter_transects<-read_xlsx("./data/transects.xlsx", sheet= "transect_fall_winter")
 
transects<- rbind(summer_transects,fall_winter_transects) #combining transect data into one data frame

transects<-transects %>% 
  select(-start_time, -end_time, -latitude_start, -longitude_start,-latitude_end, -longitude_end) # removing extraneous columns: 
# start_time, end_time, latitude_start, longitude_start, latitude_end, longitude_end, notes

# Loading in the data for quadrats
tidal_quadrats<-read_xlsx("./data/transects.xlsx", sheet= "tidal_elevation_quadrats")

# ===================================================================
# Calculating Frequency of Occurrence at the Tidal Elevation Level
# ===================================================================
taxa_transecttidal_counts<-taxa %>% 
  unite(transect_tidal, site_code, tidal_zone, season, sep="_")

taxa_transecttidal_counts<-taxa_transecttidal_counts %>% 
  count(transect_tidal, taxa)

taxa_transecttidal_frequency<-left_join(taxa_transecttidal_counts, tidal_quadrats, by= "transect_tidal")

taxa_transecttidal_frequency <-taxa_transecttidal_frequency %>% 
  mutate(frequency_occur=n/total_quadrats)

# ===================================================================
# Calculating Mean Frequency of Occurrence at the Tidal zone Level
# ===================================================================
mean_frequency<-taxa_transecttidal_frequency %>%
  group_by(site_code,tidal_zone, taxa) %>%
  summarize(
    mean_value = mean(frequency_occur), 
    sd_value = sd(frequency_occur),    
    n = n(),                                       
    se_value = sd_value / sqrt(n)                  
  )
# ===================================================================
# Calculating Aggregated NNS Frequency of Occurrence
# ===================================================================
# First creating a variable that combines things by tidal zone in season rather than transect
monterey<-taxa %>% 
  filter(region=="monterey")

monterey<-monterey %>% 
unite(transect_tidal,site_code,tidal_zone,season,sep="_")

# This gives the number of quadrats in a tidal zone where a NNS was found
monterey_unique_quadrat_count<-monterey %>% 
  group_by(transect_tidal) %>% 
  summarise(unique_quadrat_count=n_distinct(quadrat_position)) 

#Joining the Data Frames
monterey_frequency<-left_join(monterey_unique_quadrat_count, tidal_quadrats, by= "transect_tidal")

#Calculating Aggregated NNS Frequency of Occurrence
NNS_frequency_mont<-monterey_frequency %>% 
  mutate(frequency_occur=unique_quadrat_count/total_quadrats)
write_xlsx(NNS_frequency_mont, "NNS_frequency_mont.xlsx")

# Calculating Aggregated NNS for SF
sf<-taxa %>% 
  filter(region=="sf")

sf<-sf %>% 
  unite(transect_tidal,site_code,tidal_zone,season,sep="_")

sf_unique_quadrat_count<-sf %>% 
  group_by(transect_tidal) %>% 
  summarise(unique_quadrat_count=n_distinct(quadrat_position)) 

sf_frequency<-left_join(sf_unique_quadrat_count, tidal_quadrats, by= "transect_tidal")

NNS_frequency_sf<-sf_frequency %>% 
  mutate(frequency_occur=unique_quadrat_count/total_quadrats)

write_xlsx(NNS_frequency_sf, "NNS_frequency_sf.xlsx")

