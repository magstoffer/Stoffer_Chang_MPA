# ===================================================================
# Percent Cover Calculations
# ===================================================================
#Changing <1 cover to 0.5
taxa$percent_cover[taxa$percent_cover=="<1"] <- "0.5"

#Changing percent cover to numeric from character 
taxa$percent_cover<-as.numeric(taxa$percent_cover)

# Calculating Maximum Percent Cover for Taxa at Each Site by Season
max_percent_cover<-taxa %>% 
  group_by(site_code, season, taxa) %>% 
  summarise(max_percent_cover= max(percent_cover, na.rm=TRUE)) 

# Calculating Mean Percent Cover for Each Taxa for Quadrats the Site Level
avg_percent_cover_site<-taxa %>% 
  group_by(site_code, taxa) %>% 
  summarise(avg_percent_cover= mean(percent_cover))

# Calculating Mean Percent Cover for Each Taxa Quadrats in Each Tidal zone Level by Season
avg_percent_cover_season<-taxa %>% 
  group_by(site_code, season, taxa, tidal_zone) %>% 
  summarise(avg_percent_cover= mean(percent_cover))

# Calculating Mean Percent Cover for Each Taxa Quadrats in Each Tidal zone Aggregated by Season 
avg_percent_cover_grouped<-taxa %>% 
  group_by(site_code,taxa, tidal_zone) %>% 
  summarise(avg_percent_cover= mean(percent_cover))

# Calculating Transect Level Percent Cover of Taxa 
percent_cover_transect<-taxa %>% 
  mutate(total_area= ((percent_cover/100)*0.25)) %>% 
  group_by(site_code,taxa, tidal_zone,season) %>% 
  summarize(sum_area=sum(total_area)) 
zone.areas<-tidal_quadrats %>% 
  select(transect_tidal, total_area)
percent_cover_transect <-percent_cover_transect %>% 
  unite(transect_tidal,site_code,tidal_zone,season,sep="_")
percent_cover_transects_calc<-left_join(percent_cover_transect, zone.areas, by="transect_tidal") %>% 
 mutate(percent_cover_tidal_zone= (sum_area/total_area))

