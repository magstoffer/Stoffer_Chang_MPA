## Generalized Linear Mixed Effect Models

**Loading Required Packages**

```{r}
library(tidyverse)
library(here)
library(DHARMa)
library(glmmTMB)
library(emmeans)
library(car)
library(cowplot)
library(ggplot2)
```

**Loading Data**

```{r}
NNS_frequency<-read.csv(here("data", "NNS_frequency_all.csv"))
```

**Running the Model**

```{r}
all_glmm<- glmmTMB(frequency_occur ~ distance_to_source_m + protection_level+ region + tidal_zone+ (1|season), data = NNS_frequency, ziformula= ~1, family = beta_family())
summary(all_glmm)
Anova(all_glmm)
```

**Examining Residuals and Joint Tests**

```{r}
plot(simulateResiduals(all_glmm))
joint_tests(all_glmm)
```

**Post-Hoc tests**

```{r}
emmeans(all_glmm, pairwise~protection_level)
emmeans(all_glmm, pairwise~region)
emmeans(all_glmm, pairwise~tidal_zone)
```

**Visualizing Results of GLMMs**

```{r}
ggplot(NNS_frequency, aes(x=(distance_to_source_m/1000), y=frequency_occur*100, color= protection_level, shape=tidal_zone)) + 
  scale_shape_manual(labels= c("low" = "Low Intertidal", "mid" = "Mid Intertidal", "high" ="High Intertidal"), values=c("low"= 19, "mid"=17, "high"=15), breaks=c("low", "mid", "high"))+
  scale_color_manual(labels=c("limited"= "Minimally Protected" , "highly" = "Highly Protected" , "fully"= "Fully Protected"), values=c("limited"= "#8c8e8f","highly"="#479dea","fully"="#ea6347"), name="Level of Protection")+
  geom_jitter(size=3, width=0.05, height=0.05)+
  geom_smooth(aes(group = 1), method = "glm", se = FALSE, color="black")+
  xlab("Distance from Source (km)")+
  ylab("% of Quadrats in Transect with NNS") +
  labs(shape="Tidal Zone")+
  facet_wrap(~region, scales="free", ncol=2)+
  theme_cowplot()+
  theme(legend.text=element_text(size=8),legend.title=element_text(size=10),strip.background=element_blank(), panel.border = element_rect(color = "black", fill = NA, size = 0.5))
```

### PERMANOVA and nMDS

**Loading Required Packages**

```{r}
library(here)
library(vegan)
library(ggplot2)
library(remotes)
library(devtools)
```

**Loading Data**

```{r}
counts.raw<-read.csv(here("data", "counts.csv"))
counts.metadata<-read.csv(here("data", "counts_metadata.csv"))
```

**Merging Count Data with Metadata at Transect Level for PERMANOVA**

```{r}
counts<- left_join(counts.raw, counts.metadata, by= "transect")
counts
```

**Bray-Curtis Dissimilarity Matrix**

```{r}
counts.raw.bc <- vegdist(counts.raw[, 3:9], method='bray')
counts.raw.bc
```

**Running PERMANOVA**

```{r}
adonis2(formula=counts.raw.bc ~ counts$protection_level + counts$distance_to_source + counts$region + counts$tidal_zone, by="margin")
```

**Post-Hoc Tests for PERMANOVA**

```{r}
# Installing pairwide.Adonis2 wrapper function
install_github("pmartinezarbizu/pairwiseAdonis/pairwiseAdonis")
library(pairwiseAdonis)

pairwise.adonis2(counts.raw.bc ~ region + distance_to_source +
                   protection_level + tidal_zone, data = counts, by = "margin")

pairwise.adonis2(counts.raw.bc ~ protection_level + region + distance_to_source + tidal_zone, data = counts, by = "margin")


pairwise.adonis2(counts.raw.bc ~ tidal_zone + region+ distance_to_source +
                   protection_level , data = counts, by = "margin")

pairwise.adonis2(counts.raw.bc ~ protection_level + region + distance_to_source + tidal_zone, data = counts, by = "margin")

```

**Visualizing Results using nMDS**

```{r}
# Do nMDS
counts.mds <- metaMDS(counts.raw.bc, distance = "bray")

# Extracting nMDS points
counts.mds.points <- data.frame(protection_level = counts$protection_level, counts.mds$points, region=counts$region, tidal_zone=counts$tidal_zone)



# Plot Not Broken Down by Region
p <- ggplot(data = counts.mds.points, aes(y = MDS2, x = MDS1, shape=tidal_zone, color = protection_level))
p + geom_point(alpha = 0.75, size=4) +
  scale_shape_manual(labels= c("low" = "Low Intertidal", "mid" = "Mid Intertidal", "high" ="High Intertidal"), values=c("low"= 19, "mid"=17, "high"=15), breaks=c("low", "mid", "high"))+
  scale_color_manual(labels=c("limited"= "Minimally Protected" , "highly" = "Highly Protected" , "fully"= "Fully Protected"), values=c("limited"= "#8c8e8f","highly"="#479dea","fully"="#ea6347"), name="Level of Protection")+
  labs(shape="Tidal Zone")+
  facet_wrap(~region, ncol=2) +
theme_minimal()+
  theme(legend.text=element_text(size=8),legend.title=element_text(size=10),strip.background=element_blank(), panel.border = element_rect(color = "black", fill = NA, size = 0.5))

# Plot of Region
p <- ggplot(data = counts.mds.points, aes(y = MDS2, x = MDS1, color = region))
p + geom_point(alpha = 0.75, size=5) +
  scale_color_manual(values=c("black","#07b815","magenta"), name="Region")+
  theme_minimal()


```

