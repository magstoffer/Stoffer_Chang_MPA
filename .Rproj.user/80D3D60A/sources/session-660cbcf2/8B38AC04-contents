# Loading Required Packages
if (!requireNamespace("pacman", quietly = TRUE)) {
  install.packages("pacman")}

pacman::p_load(tidyverse, vegan)

############################
# LOADING THE DATA
############################
prey_matrix<-read.csv("Data/prey_matrix.csv")
meta<-read.csv("Data/meta.csv")

prey<-bind_cols(meta, prey_matrix)

############################
# SPECIES RICHNESS
############################
# Species Richness by Year
richness_year<-specnumber(prey_matrix, groups = meta$year)
richness_year

# Species Richness by PSD Cat
richness_psd<-specnumber(prey_matrix, groups = meta$psd_cat)
richness_psd

############################
# ALPHA DIVERSITY (SHANNON)
############################
shannon_year<-diversity(prey_matrix, index = "shannon", groups = meta$year, equalize.groups=FALSE)
shannon_year

shannon_psd<-diversity(prey_matrix, index = "shannon", groups = meta$psd_cat, equalize.groups=FALSE)
shannon_psd

############################
# CALCULATING PIELOU'S EVENNESS
############################
pielou_year <- shannon_year / log(richness_year)
pielou_year

pielou_psd<-shannon_psd/log(richness_psd)
pielou_psd

############################
# ALPHA DIVERSITY (SIMPSON)
############################
simpson_year<-diversity(prey_matrix, index = "simpson", groups = meta$year, equalize.groups=FALSE)
simpson_year

simpson_psd<-diversity(prey_matrix, index = "simpson", groups = meta$psd_cat, equalize.groups=FALSE)
simpson_psd

